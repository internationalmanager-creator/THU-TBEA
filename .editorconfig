# =====================================================================
# PIR — EditorConfig
# Reglas de formato comunes. Compatible con VSCode, PyCharm, Sublime,
# Vim, Emacs. Respeta la convencion: LF para todo (Windows y Linux).
# =====================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,pyi}]
indent_size = 4
max_line_length = 100

[*.{json,yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[*.{sh,bash}]
indent_size = 4

[*.ps1]
indent_size = 4

[Makefile]
indent_style = tab

[*.{tex,bib}]
indent_size = 2
trim_trailing_whitespace = false

[*.{sql}]
indent_size = 4